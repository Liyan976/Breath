                "limitSymbolsToIncludedHeaders": true
            },
            "defines": [
                "USE_HAL_DRIVER",
                "STM32F405xx",
                "ARM_MATH_CM4",
                "HSE_VALUE=8000000",
                "__CC_ARM",
                "__arm__",
                "__align(x)=",
                "__ALIGNOF__(x)=",
                "__alignof__(x)=",
                "__asm(x)=",
                "__forceinline=",
                "__restrict=",
                "__global_reg(n)=",
                "__inline=",
                "__int64=long long",
                "__INTADDR__(expr)=0",
                "__irq=",
                "__packed=",
                "__pure=",
                "__smc(n)=",
                "__svc(n)=",
                "__svc_indirect(n)=",
                "__svc_indirect_r7(n)=",
                "__value_in_regs=",
                "__weak=",
                "__writeonly=",
                "__declspec(x)=",
                "__attribute__(x)=",
                "__nonnull__(x)=",
                "__register=",
                "__breakpoint(x)=",
                "__clrex()=",
                "__clz(x)=0U",
                "__disable_fiq()=",
                "__disable_irq()=",
                "__dmb(x)=",
                "__dsb(x)=",
                "__enable_fiq()=",
                "__enable_irq()=",
                "__isb(x)=",
                "__ldrex(x)=0U",
                "__nop()=",
                "__rbit(x)=0U",
                "__rev(x)=0U",
                "__strex(x,y)=0U",
                "__wfe()=",
                "__wfi()="
            ],
            "compilerPath": "D:/ARM/ARMCC/bin/armcc.exe",
            "intelliSenseMode": "gcc-arm",
            "cStandard": "c99",
            "cppStandard": "c++17"
        }
    ],
    "version": 4
}
