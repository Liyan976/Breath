                    "${workspaceFolder}/Core",
                    "${workspaceFolder}/Screen",
                    "${workspaceFolder}/Bluetooth",
                    "${workspaceFolder}/Audio",
                    "${workspaceFolder}/Stimulator",
                    "${workspaceFolder}/BreathSensor",
