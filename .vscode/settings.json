{
    // 强制启用微软 C/C++ 官方 IntelliSense 语义分析与精准跳转
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.intelliSenseEngineFallback": "Disabled",

    // 禁用此工程下的 STM32Cube Clangd，防止其因缺少 compile_commands.json 劫持跳转
    "stm32cube-ide-clangd.enable": false,
    "clangd.enable": false,

    // 跳转行为：有多重定义或声明时直接精准跳转到目标，不弹出内联偷窥 Peek 窗口
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",

    // 符号索引与本地持久化数据库
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": false,
    "C_Cpp.default.browse.databaseFilename": "${workspaceFolder}/.vscode/vc.db",

    // 保持代码视窗整洁，禁用波浪线报错
    "C_Cpp.errorSquiggles": "disabled",
    "Codegeex.RepoIndex": true,
    "editor.mouseWheelZoom": true,

    // 本工程为 Keil MDK (uvprojx) 工程，不使用 CMake 构建。
    // 禁用 CMake 插件在当前工作区的自动激活、扫描与弹窗提示：
    "cmake.autoDetectSourceDirectory": false,
    "cmake.configureOnOpen": false,
    "cmake.enableAutomaticKitScan": false,
    "cmake.ignoreCMakeListsMissing": true,
    "cmake.sourceDirectory": ""
}
